[Unit]
Description=sapp service
{% if tsg_running_type != 0 %}
Requires=mrzcpd.service
After=mrzcpd.service
{% endif %}
[Service]
Type=notify
WorkingDirectory=/home/mesasoft/sapp_run
ExecStart=/home/mesasoft/sapp_run/sapp
TimeoutSec=300s
RestartSec=10s
Restart=always
LimitNOFILE=524288
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=process

[Install]
WantedBy=multi-user.target
