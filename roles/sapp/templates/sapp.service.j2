[Unit]
Description=sapp service
Requires=mrzcpd.service
After=mrzcpd.service
[Service]
Type=notify
WorkingDirectory=/home/mesasoft/sapp_run
ExecStart=/home/mesasoft/sapp_run/sapp
TimeoutSec=900s
RestartSec=10s
Restart=always
LimitNOFILE=524288
LimitNPROC=infinity
LimitCORE=0
TasksMax=infinity
Delegate=yes
KillMode=process
WatchdogSec=10s

[Install]
WantedBy=multi-user.target
